# Default backend address of the app (can be changed in the app: Server settings)
# `make` overrides it with the backend's public link (written to mobile/.env.local)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Temporary test login: one of the accounts created by `make` (backend/prisma/seed.ts)
EXPO_PUBLIC_TEST_EMAIL=
EXPO_PUBLIC_TEST_PASSWORD=
